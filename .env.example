# Postgres (Neon, Supabase, etc.) — required locally and on Vercel
# Use sslmode=verify-full with Node's `pg` driver (avoids a dev-overlay SSL warning; Neon supports it)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"
JWT_SECRET="generate-a-long-random-string-at-least-32-characters"

# Optional: “See more on Instagram” link on the footer (safe to be public)
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/yourhandle"

# Site URL for metadata / social previews
NEXT_PUBLIC_SITE_URL="https://stitchnstab.com"

# Vercel Blob — auto-added when you create a Blob store in Vercel (do not set locally unless testing)
# BLOB_READ_WRITE_TOKEN=
